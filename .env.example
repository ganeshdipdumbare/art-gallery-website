# Turso database (required for the app to run)
# Copy to .env.local and add your real values
# Get URL: turso db show ursula-gallery --url
# Get token: turso db tokens create ursula-gallery
TURSO_DATABASE_URL=libsql://ursula-gallery-politics.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# PayPal (for checkout and IPN webhook)
NEXT_PUBLIC_PAYPAL_EMAIL=your-paypal@example.com
# Required for IPN notify_url when building URLs server-side; client uses window.location.origin
NEXT_PUBLIC_APP_URL=https://your-site.com
